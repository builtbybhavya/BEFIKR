# Set these in the backend process environment before starting; never commit secrets.
BEFIKR_TOKEN_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BEFIKR_DATA_DIR=./data
BEFIKR_ADMIN_EMAIL=
BEFIKR_ADMIN_PASSWORD=
BEFIKR_MAPPING_PROVIDER=auto
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_BROWSER_KEY=
# Optional separate website-restricted Maps Embed API key. Falls back to the browser key.
GOOGLE_MAPS_EMBED_KEY=
MAPBOX_ACCESS_TOKEN=
FCM_CREDENTIALS=
SMS_API_KEY=
BEFIKR_CORS_ORIGINS=http://localhost:8000
